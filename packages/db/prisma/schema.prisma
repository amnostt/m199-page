// === Enforcement Tiers ===
// DB:  → Prisma constructs: @unique, @@unique, @@index, @default, enum, required field, relation
// APP: → API/service logic, transactional writes, future SQL migrations
//
// Current Prisma schema for the Misión 1-99 application.
// packages/db owns its migration history and generated Prisma Client workflow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 keeps the connection URL in packages/db/prisma.config.ts.
}

enum ResponsibleUserStatus {
  ACTIVE
  INACTIVE
}

enum RefreshSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RefreshFamilyStatus {
  ACTIVE
  TERMINATED
}

enum RefreshOperationStatus {
  COMPLETED
  INVALIDATED
}

enum MissionStatus {
  ACTIVE
  ARCHIVED
}

enum PublicationType {
  POST
  OUTING
  EVENT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

enum PublicationScope {
  GENERAL
  MISSION
}

enum ActivityStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum DocumentationStatus {
  PENDING_DOCUMENTATION
  DOCUMENTED
}

enum FileStorageProvider {
  LOCAL
}

enum FileCategory {
  MISSION_HERO
  PUBLICATION_FEATURED_IMAGE
  PUBLICATION_DOWNLOAD
  LANDING_HERO
  OTHER
}

model ResponsibleUser {
  // DB: Unique email (@unique), status enum tracks ACTIVE/INACTIVE, @@index([status])
  // APP: Login/content-creation guards must check status != INACTIVE
  id           String                @id @default(uuid())
  email        String                @unique
  displayName  String
  passwordHash String
  authVersion  Int                   @default(0)
  status       ResponsibleUserStatus @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  refreshSessions   RefreshSession[]
  refreshFamilies   RefreshFamily[]
  authoredPublications Publication[]
  authoredVerses    Verse[]
  verseRevisions    VerseRevision[]
  uploadedFiles     FileAsset[]

  @@index([status])
}

model RefreshSession {
  // DB: tokenHash @unique, status/expiresAt columns, @@index([userId, status]), @@index([expiresAt]), @@index([status, expiresAt])
  // APP: Hash-only storage; app layer handles revoke/rotate/expiry lifecycle
  id        String               @id @default(uuid())
  userId    String
  tokenHash String               @unique
  status    RefreshSessionStatus @default(ACTIVE)
  userAgent String?
  ipHash    String?
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user ResponsibleUser @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

model RefreshFamily {
  // APP: the family row is the serialized authority for refresh rotation,
  // bounded replay, and terminal logout. Current token material is encrypted;
  // only its hash is used for indexed equality checks.
  id                    String             @id
  userId                String
  status                RefreshFamilyStatus @default(ACTIVE)
  currentVersion        Int
  currentTokenHash      String             @unique
  encryptedCurrentToken String
  expiresAt             DateTime
  terminalAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user       ResponsibleUser   @relation(fields: [userId], references: [id])
  operations RefreshOperation[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

model RefreshOperation {
  // APP: one operation can be retried only with the same presented lineage and
  // proof. The presented-version unique key records each consumed descendant.
  id                           String                  @id
  familyId                     String
  operationId                  String
  presentedVersion             Int
  presentedJti                 String
  presentedIssuedByOperationId String
  presentedProofHash           String
  childVersion                 Int
  encryptedResult              String
  completedAt                  DateTime
  replayUntil                  DateTime
  status                       RefreshOperationStatus @default(COMPLETED)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  family RefreshFamily @relation(fields: [familyId], references: [id])

  @@unique([familyId, operationId])
  @@unique([familyId, presentedVersion])
  @@index([familyId, childVersion])
  @@index([familyId, replayUntil])
}

model FileAsset {
  // DB: fileSize, mimeType, extension metadata columns, @@index([category]), @@index([uploadedById]), @@index([createdAt])
  // APP: Upload MIME/size limits validated per FileCategory before insert
  id              String              @id @default(uuid())
  storageProvider FileStorageProvider @default(LOCAL)
  category        FileCategory
  originalFilename String
  mimeType        String
  extension       String?
  fileSize        Int
  storagePath     String
  url             String
  metadata        Json?
  thumbnailPath   String?
  uploadedById    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime             @updatedAt

  uploadedBy ResponsibleUser? @relation(fields: [uploadedById], references: [id])

  missionHeroes          Mission[]          @relation("MissionHeroImage")
  publicationFeatures    Publication[]      @relation("PublicationFeaturedImage")
  landingHeroes          LandingSettings[]  @relation("LandingHero")

  @@index([category])
  @@index([uploadedById])
  @@index([createdAt])
}

model Mission {
  // APP: Mission is not deletable; archive preserves public visibility; BEFORE DELETE trigger blocks deletion
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  heroImageId String
  heroPhrase  String
  status      MissionStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  heroImage    FileAsset           @relation("MissionHeroImage", fields: [heroImageId], references: [id], onDelete: Restrict)
  publications PublicationMission[]

  @@index([status])
}

model Publication {
  // APP: Type-change validation must run transactionally before write;
  //     scope exclusivity (GENERAL XOR ≥1 Mission link) enforced by trigger.
  id                   String                 @id @default(uuid())
  slug                 String                 @unique
  title                String
  excerpt              String
  content              String
  featuredImageId      String
  authorId             String?
  type                 PublicationType
  status               PublicationStatus      @default(DRAFT)
  publishedAt          DateTime?
  scope                PublicationScope       @default(GENERAL)
  startDate            DateTime?
  endDate              DateTime?
  activityStatus       ActivityStatus?
  documentationStatus DocumentationStatus?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  featuredImage FileAsset            @relation("PublicationFeaturedImage", fields: [featuredImageId], references: [id], onDelete: Restrict)
  author        ResponsibleUser?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  missions      PublicationMission[]

  @@index([status, publishedAt])
  @@index([type])
  @@index([authorId])
}

model PublicationMission {
  // DB: composite primary key (publicationId, missionId); FK to Publication ON DELETE CASCADE; FK to Mission ON DELETE CASCADE
  // APP: scope trigger keeps Publication.scope in sync with link count
  publicationId String
  missionId     String
  createdAt     DateTime @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  mission     Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([publicationId, missionId])
  @@index([missionId])
}

model Verse {
  // DB: multiple verses per date allowed; publishedAt is the UTC instant of creation;
  //     date is the Peru business-day date derived from publishedAt (America/Lima).
  //     @@index([status, publishedAt]) for latest-remaining ordering; @@index([createdById]).
  id          String        @id @default(uuid())
  text        String
  reference   String
  date        DateTime
  publishedAt DateTime?
  status      PublicationStatus @default(PUBLISHED)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdBy ResponsibleUser? @relation(fields: [createdById], references: [id])
  revisions VerseRevision[]

  @@index([status, publishedAt])
  @@index([createdById])
}

model VerseRevision {
  id          String   @id @default(uuid())
  verseId     String
  text        String
  reference   String
  changedAt   DateTime @default(now())
  changedById String?

  verse     Verse            @relation(fields: [verseId], references: [id], onDelete: Cascade)
  changedBy ResponsibleUser? @relation(fields: [changedById], references: [id])

  @@index([verseId, changedAt])
}

model LandingSettings {
  // DB: Singleton enforcement: service keeps exactly one row with id = 1
  // APP: featuredOuting payload removed; hero payload preserved
  id               Int      @id @default(1)
  heroTitle        String?
  heroSubtitle     String?
  heroImageId      String?
  mission          String?
  vision           String?
  description      String?
  featuredVideoUrl String?
  contactEmail     String?
  contactPhone     String?
  updatedAt        DateTime @updatedAt

  heroImage FileAsset? @relation("LandingHero", fields: [heroImageId], references: [id])
}

// APP-tier invariants: FileAsset upload validation per FileCategory; type-change
// confirmation for Publication; PublicationMission scope trigger keeps scope in
// sync at commit; Mission deletion is blocked by BEFORE DELETE trigger;
// RefreshSession lifecycle is hash-only at the application layer.
