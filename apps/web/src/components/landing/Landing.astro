---
/**
 * Landing.astro — pure presentational landing surface for the Astro
 * SSR (PR3 root rendering, recomposed for the OpenDesign rhythm).
 *
 * Export rhythm (top to bottom):
 *   1. Skip link + header (LandingNavbar) inside the
 *      `<header>` so the first focusable element is the
 *      "Saltar al contenido" link.
 *   2. `<main id="contenido">` wraps every section so the skip
 *      link destination is unique and unambiguous.
 *   3. Hero (CMS image foreground + design background, decorative
 *      brand isotype).
 *   4. Dynamic verse (currentVerse from the payload).
 *   5. Visual banner (`/assets/redesign/banner.png`).
 *   6. Real missions (omitted for null/empty).
 *   7. Honest static publications entry linking /publicaciones
 *      (no fake href/anchor, no restored legacy payload).
 *   8. About (CMS narrative precedence + local gallery + featured
 *      video + optional contact CTA).
 *   9. Contact (conditional channels; never placeholder values).
 *  10. Footer (always present).
 *
 * The failure branch is intentionally generic and NEVER includes
 * the failure reason, the API host, the stack, or any driver
 * detail. The HTTP status (503) is set in the page wrapper, not
 * here. The iframe is only emitted when the payload has a
 * non-null `featuredVideoUrl` already sanitized by the landing
 * helper.
 */
import type {
  LandingFailure,
  LandingPayloadShape,
} from "./landing-shape.js";
import LandingNavbar from "./LandingNavbar.astro";
import LandingHero from "./LandingHero.astro";
import LandingVerse from "./LandingVerse.astro";
import LandingBanner from "./LandingBanner.astro";
import LandingMissions from "./LandingMissions.astro";
import LandingPublications from "./LandingPublications.astro";
import LandingAbout from "./LandingAbout.astro";
import LandingContact from "./LandingContact.astro";
import type { MissionListItem } from "../../lib/server/missions.js";

interface Props {
  payload: LandingPayloadShape | null;
  failure: LandingFailure | null;
  missions: MissionListItem[] | null;
}

const { payload, failure, missions = null } = Astro.props;

const missionHref = payload ? "/misiones" : "#inicio";
const hasAbout = Boolean(
  payload &&
    (payload.mission?.trim() ||
      payload.vision?.trim() ||
      payload.description?.trim() ||
      payload.featuredVideoUrl),
);
const hasContact = Boolean(
  payload && (payload.contactEmail?.trim() || payload.contactPhone?.trim()),
);
const aboutHref = hasAbout ? "#nosotros" : "#inicio";
const contactHref = hasContact ? "#contacto" : "#inicio";
const publicationsHref = "/publicaciones";
---

{failure ? (
  <main
    class="public-ui public-page landing-page"
    id="contenido"
    data-testid="landing-error"
    aria-live="polite"
  >
    <LandingNavbar
      missionHref={missionHref}
      aboutHref={aboutHref}
      contactHref={contactHref}
      publicationsHref={publicationsHref}
    />
    <div id="inicio" class="public-visually-hidden" aria-hidden="true"></div>
    <section
      class="public-state public-state--error"
      data-testid="landing-error-section"
    >
      <p>La página no se puede cargar en este momento. Intentá nuevamente en unos minutos.</p>
    </section>
  </main>
) : payload ? (
  <main
    class="public-ui public-page landing-page"
    id="contenido"
    data-testid="landing-page"
  >
    <LandingNavbar
      missionHref={missionHref}
      aboutHref={aboutHref}
      contactHref={contactHref}
      publicationsHref={publicationsHref}
    />

    <LandingHero
      heroTitle={payload.heroTitle}
      heroSubtitle={payload.heroSubtitle}
      heroImageUrl={payload.heroImageUrl}
    />

    <LandingVerse verse={payload.currentVerse} />

    <LandingBanner />

    <LandingMissions missions={missions} />

    <LandingPublications />

    <LandingAbout
      mission={payload.mission}
      vision={payload.vision}
      description={payload.description}
      featuredVideoUrl={payload.featuredVideoUrl}
      hasContact={hasContact}
    />

    <LandingContact
      contactEmail={payload.contactEmail}
      contactPhone={payload.contactPhone}
    />
  </main>
) : null}
