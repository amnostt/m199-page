---
interface Props {
  featuredVideoUrl: string | null;
}

const { featuredVideoUrl } = Astro.props;
---

{featuredVideoUrl && (
  <section
    class="landing-featured-video"
    id="video-destacado"
    data-testid="video-section"
    aria-labelledby="featured-video-title"
  >
    <div class="landing-featured-video__inner">
      <header class="landing-featured-video__header">
        <p class="landing-featured-video__eyebrow">En acción</p>
        <h2 id="featured-video-title">Video destacado</h2>
      </header>
      <div class="public-media public-media--cover landing-featured-video__media">
        <video
          src={featuredVideoUrl}
          title="Misión 1-99 en acción"
          data-testid="featured-video"
          controls
          preload="metadata"
          style="display: block; width: 100%; height: 100%; object-fit: cover;"
        >
          Tu navegador no admite la reproducción de video.
        </video>
      </div>
    </div>
  </section>
)}
