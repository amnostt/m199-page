---
import type { MissionListItem } from "../../lib/server/missions.js";

interface Props {
  missions: MissionListItem[] | null;
}

const { missions } = Astro.props;
---

{missions && missions.length > 0 && <section
  class="public-section landing-missions"
  id="misiones"
  data-testid="missions-section"
  aria-labelledby="missions-title"
>
  <header class="landing-missions__header">
    <div>
      <p class="landing-missions__kicker">Ministerios y misiones</p>
      <h2 id="missions-title">Misiones</h2>
    </div>
    <a class="landing-missions__status" href="/misiones">Ver todas las misiones</a>
  </header>

  <div class="public-card-list">
    {missions.map((mission) => <article class="public-mission-card public-card">
      <img src={mission.heroImageUrl} alt="" />
      <h3><a href={`/misiones/${mission.slug}`}>{mission.title}</a></h3>
      <p>{mission.heroPhrase}</p>
    </article>)}
  </div>
</section>}
