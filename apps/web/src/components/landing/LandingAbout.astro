---
/**
 * LandingAbout.astro — "Nosotros" block with narrative precedence.
 *
 * Narrative precedence (already validated upstream):
 *   1. `description`
 *   2. `mission`
 *   3. `vision`
 *
 * Visual composition (back-to-front):
 *   - Editorial copy + headline.
 *   - Local gallery figures (ours-1, ours-2, ours-3) using the
 *     bundled OpenDesign assets at `/assets/redesign/ours-*.png`.
 *   - Optional "Quiero ser parte" CTA, only rendered when the
 *     payload exposes at least one contact channel (the parent
 *     passes `hasContact`).
 */
import type { LandingPayloadShape } from "./landing-shape.js";

interface Props extends Pick<LandingPayloadShape, "mission" | "vision" | "description"> {
  hasContact: boolean;
}

const { mission, vision, description, hasContact } = Astro.props;
const narrative = description?.trim() || mission?.trim() || vision?.trim();
const hasContent = Boolean(narrative);
const galleryImages = [
  {
    src: "/assets/redesign/ours-1.png",
    alt: "Conversación cercana durante una salida en la calle",
  },
  {
    src: "/assets/redesign/ours-2.png",
    alt: "Miembro de Misión 1-99 acompañando una actividad comunitaria",
  },
  {
    src: "/assets/redesign/ours-3.png",
    alt: "Equipo de Misión 1-99 compartiendo Café con Jesús",
  },
];
---

{hasContent && (
  <section
    class="public-section landing-about"
    id="nosotros"
    data-testid="about-section"
    aria-labelledby="about-title"
  >
    <div class="landing-about__inner">
      <div class="landing-about__intro">
        <p class="landing-about__eyebrow">Nosotros</p>
        <h2 id="about-title" class="landing-about__title">
          No esperamos.<br />
          <span class="landing-about__underline">Salimos.</span>
        </h2>
        {narrative && (
          <p class="landing-about__copy" data-testid="about-description">{narrative}</p>
        )}
      </div>

      <div class="landing-about__media" data-testid="about-media">
        <div class="landing-about__gallery" data-testid="about-gallery">
          {galleryImages.map((image, index) => (
            <figure class="landing-about__figure" data-testid={`about-image-${index + 1}`}>
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                class="landing-about__image"
              />
            </figure>
          ))}
        </div>

        {hasContact && (
          <a class="landing-about__action" href="#contacto" data-testid="about-cta">
            Quiero ser parte
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>
  </section>
)}
