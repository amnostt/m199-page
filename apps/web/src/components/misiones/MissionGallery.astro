---
const { gallery = [] } = Astro.props;
---
{gallery.length > 0 && (
  <section
    class="public-mission-detail__gallery"
    data-testid="mission-gallery"
    aria-labelledby="mission-gallery-title"
  >
    <div class="public-mission-detail__section-heading">
      <h2 id="mission-gallery-title">La Misión en imágenes</h2>
    </div>
    <div class="public-mission-detail__gallery-grid">
      {gallery.map((image: { imageUrl: string }) => (
        <figure class="public-mission-detail__gallery-item">
          <img src={image.imageUrl} alt="" loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </section>
)}
