---
import { formatPublicDate } from "../../lib/server/public-content.js";
import {
  PUBLIC_IMAGE_FALLBACK_HANDLER,
  resolvePublicImageUrl,
} from "../../lib/public-image.js";

const { publication } = Astro.props;
const imageSrc = resolvePublicImageUrl(publication.featuredImageUrl);
---
<article class="public-mission-publication" data-testid="mission-publication">
  <div class="public-mission-publication__content">
    <p class="public-mission-publication__type">{publication.type}</p>
    <h3>
      <a href={`/publicaciones/${publication.slug}`}>{publication.title}</a>
    </h3>
    <p class="public-mission-publication__excerpt">{publication.excerpt}</p>
    <time datetime={publication.publishedAt}>
      {formatPublicDate(publication.publishedAt)}
    </time>
  </div>
  <img
    class="public-mission-publication__image"
    src={imageSrc}
    alt=""
    loading="lazy"
    decoding="async"
    onerror={PUBLIC_IMAGE_FALLBACK_HANDLER}
  />
</article>
