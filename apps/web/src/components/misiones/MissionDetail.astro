---
import {
  PUBLIC_IMAGE_FALLBACK_HANDLER,
  resolvePublicImageUrl,
} from "../../lib/public-image.js";
import MissionFinishedBadge from "./MissionFinishedBadge.astro";
import MissionPublicationItem from "./MissionPublicationItem.astro";
import MissionPageNav from "./MissionPageNav.astro";
import PublicImageCarousel from "../public/PublicImageCarousel.js";
const { mission } = Astro.props;
const publications = mission.publications ?? [];
const gallery = mission.gallery ?? [];
const imageUrls = [
  mission.heroImageUrl,
  ...gallery.map((image: { imageUrl: string }) => image.imageUrl),
]
  .map(resolvePublicImageUrl)
  .filter((image, index, images) => images.indexOf(image) === index);
const profileImageSrc = mission.profileImageUrl
  ? resolvePublicImageUrl(mission.profileImageUrl)
  : null;
---
<main class="public-ui public-page public-mission-detail" data-testid="mission-detail">
  <MissionPageNav current="detail" />

  <section class="public-mission-detail__hero" aria-labelledby="mission-title">
    <div class="public-mission-detail__hero-media">
      <PublicImageCarousel
        images={imageUrls}
        label={`la misión ${mission.title}`}
        heading="La Misión en imágenes"
        client:load
      />
    </div>
    <div class="public-mission-detail__hero-copy">
      {profileImageSrc && (
        <div class="public-mission-detail__profile" data-testid="mission-profile-image">
          <img
            src={profileImageSrc}
            alt={`Logotipo de ${mission.title}`}
            onerror={PUBLIC_IMAGE_FALLBACK_HANDLER}
          />
        </div>
      )}
      {mission.finished && <MissionFinishedBadge />}
      <h1 id="mission-title">{mission.title}</h1>
      <p class="public-mission-detail__phrase">{mission.heroPhrase}</p>
      {publications.length > 0 && (
        <a class="public-mission-detail__hero-link" href="#mission-publications">
          Explorar publicaciones
        </a>
      )}
    </div>
  </section>

  <section
    class="public-mission-detail__publications"
    id="mission-publications"
    data-testid="mission-publications"
    aria-labelledby="mission-publications-title"
  >
    <div class="public-mission-detail__section-heading">
      <h2 id="mission-publications-title">Publicaciones relacionadas</h2>
    </div>
    {publications.length > 0 ? (
      <div class="public-mission-detail__publication-list">
        {publications.map((publication: object) => (
          <MissionPublicationItem publication={publication} />
        ))}
      </div>
    ) : (
      <p class="public-mission-detail__empty">No hay publicaciones relacionadas.</p>
    )}
  </section>
</main>
