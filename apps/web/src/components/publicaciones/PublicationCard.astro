---
import { formatPublicDate } from "../../lib/server/public-content.js";

const { publication } = Astro.props;
---
<article class="public-publication-card">
  <a class="public-publication-card__link" href={`/publicaciones/${publication.slug}`}>
    <div class="public-publication-card__media">
      {publication.featuredImageUrl ? (
        <img
          src={publication.featuredImageUrl}
          alt=""
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="public-publication-card__media-placeholder" aria-hidden="true">
          Misión 1-99
        </span>
      )}
    </div>
    <div class="public-publication-card__body">
      <div class="public-publication-card__meta">
        <p class="public-publication-card__type">{publication.type}</p>
        <time datetime={publication.publishedAt}>
          {formatPublicDate(publication.publishedAt)}
        </time>
      </div>
      <h2>{publication.title}</h2>
      <p class="public-publication-card__excerpt">{publication.excerpt}</p>
      <span class="public-publication-card__action">Leer publicación ↗</span>
    </div>
  </a>
</article>
