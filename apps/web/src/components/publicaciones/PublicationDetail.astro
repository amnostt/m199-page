---
import {
  PUBLIC_IMAGE_FALLBACK_HANDLER,
  resolvePublicImageUrl,
} from "../../lib/public-image.js";
import PublicationBadges from "./PublicationBadges.astro";
import PublicationContent from "./PublicationContent.astro";
import PublicationMissionsList from "./PublicationMissionsList.astro";
import PublicationGallery from "./PublicationGallery.astro";
import PublicationPageNav from "./PublicationPageNav.astro";
import {
  formatPublicDate,
  getPublicationCta,
  getPublicationDate,
  getPublicationTimelineLabel,
} from "../../lib/server/public-content.js";

const publicationTypeLabels: Record<string, string> = {
  POST: "Historia",
  OUTING: "Salida",
  EVENT: "Evento",
};

const { publication } = Astro.props;
const typeLabel = publicationTypeLabels[publication.type] ?? publication.type;
const imageUrls = Array.isArray(publication.imageUrls) ? publication.imageUrls : [];
const imageSrc = resolvePublicImageUrl(imageUrls[0] ?? publication.featuredImageUrl);
const dateValue = getPublicationDate(publication);
const timelineLabel = getPublicationTimelineLabel(publication);
---

<main
  class:list={[
    "public-ui",
    "public-page",
    "public-publication-detail",
  ]}
  data-testid="publication-detail"
>
  <PublicationPageNav current="detail" />

  <section class="public-publication-detail__hero" aria-labelledby="publication-title">
    <div class="public-publication-detail__hero-media">
      <img src={imageSrc} alt="" onerror={PUBLIC_IMAGE_FALLBACK_HANDLER} />
    </div>
    <div class="public-publication-detail__hero-copy">
      <p class="public-publication-detail__type">{typeLabel}</p>
      <h1 id="publication-title">{publication.title}</h1>
      <p class="public-publication-detail__excerpt">{publication.excerpt}</p>
      <div class="public-publication-detail__meta">
        {timelineLabel && <p class="public-publication-detail__timeline">{timelineLabel}</p>}
        <time datetime={dateValue}>
          {formatPublicDate(dateValue)}
        </time>
        <PublicationBadges publication={publication} />
      </div>
      <a class="public-publication-detail__hero-link" href="#publication-content">
        {getPublicationCta(publication.type)}
      </a>
    </div>
  </section>

  <section
    class="public-publication-detail__content-section"
    id="publication-content"
    aria-labelledby="publication-content-title"
  >
    <div class="public-publication-detail__section-heading">
      <p>Contenido</p>
      <h2 id="publication-content-title">La historia continúa</h2>
    </div>
    <PublicationContent content={publication.content} />
  </section>

  <PublicationGallery imageUrls={imageUrls} />

  <PublicationMissionsList missions={publication.missions} />
</main>
