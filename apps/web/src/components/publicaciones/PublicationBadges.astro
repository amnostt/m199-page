---
import {
  formatPublicDate,
  getPublicationDate,
  getPublicationTimelineLabel,
} from "../../lib/server/public-content.js";

const { publication } = Astro.props;
const isActivity = publication.type === "OUTING" || publication.type === "EVENT";
const dateValue = getPublicationDate({
  ...publication,
  activityDate: publication.activityDate ?? publication.startDate,
});
const timelineLabel = publication.activityDate
  ? getPublicationTimelineLabel(publication)
  : ({ COMPLETED: "Revive lo que hicimos", UPCOMING: "Próximamente", CANCELLED: "Revive lo que hicimos" } as Record<string, string | null>)[publication.activityStatus] ?? null;
const legacyActivityLabel = publication.activityDate
  ? null
  : ({ COMPLETED: "Actividad realizada", UPCOMING: "Próxima actividad", CANCELLED: "Actividad cancelada" } as Record<string, string | null>)[publication.activityStatus] ?? null;
const legacyDocumentationLabel = publication.activityDate
  ? null
  : ({ DOCUMENTED: "Documentada", PENDING_DOCUMENTATION: "Documentación pendiente" } as Record<string, string | null>)[publication.documentationStatus] ?? null;
---
{isActivity && <div class="public-publication-badges" data-testid="publication-badges">
  <span class="public-publication-badge">
    <span class="public-publication-badge__label">Fecha</span>
    <time datetime={dateValue}>{formatPublicDate(dateValue)}</time>
  </span>
  {timelineLabel && <span class="public-publication-badge">{timelineLabel}</span>}
  {legacyActivityLabel && <span class="public-publication-badge">{legacyActivityLabel}</span>}
  {legacyDocumentationLabel && <span class="public-publication-badge">{legacyDocumentationLabel}</span>}
</div>}
