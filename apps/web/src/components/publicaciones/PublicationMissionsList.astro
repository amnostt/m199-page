---
interface Mission {
  slug: string;
  title: string;
  status: "ACTIVE" | "ARCHIVED";
}
const { missions } = Astro.props as { missions: Mission[] };
---
{missions.length > 0 && <section data-testid="publication-missions" aria-label="Misiones asociadas">
  <h2>Misiones asociadas</h2>
  <ul>
    {missions.map((mission) => <li>
      <a href={`/misiones/${mission.slug}`}>{mission.title}</a>
      {mission.status === "ARCHIVED" && <span> (Misión finalizada)</span>}
    </li>)}
  </ul>
</section>}
