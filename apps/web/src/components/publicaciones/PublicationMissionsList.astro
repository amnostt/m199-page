---
import {
  PUBLIC_IMAGE_FALLBACK_HANDLER,
  resolvePublicImageUrl,
} from "../../lib/public-image.js";

interface Mission {
  slug: string;
  title: string;
  status: "ACTIVE" | "ARCHIVED";
  profileImageUrl: string | null;
}
const { missions } = Astro.props as { missions: Mission[] };
---
{missions.length > 0 && (
  <section
    class="public-publication-missions"
    data-testid="publication-missions"
    aria-label="Misiones asociadas"
  >
    <div class="public-publication-detail__section-heading">
      <p>En contexto</p>
      <h2>Misiones asociadas</h2>
    </div>
    <ul class="public-publication-missions__list">
      {missions.map((mission) => (
        <li class="public-publication-missions__item">
          <a class="public-publication-missions__link" href={`/misiones/${mission.slug}`}>
            <span class="public-publication-missions__identity">
              {mission.profileImageUrl && (
                <span
                  class="public-publication-missions__profile"
                  data-testid="publication-mission-logo"
                >
                  <img
                    src={resolvePublicImageUrl(mission.profileImageUrl)}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    onerror={PUBLIC_IMAGE_FALLBACK_HANDLER}
                  />
                </span>
              )}
              <span>{mission.title}</span>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
          {mission.status === "ARCHIVED" && (
            <span class="public-publication-missions__status">Misión finalizada</span>
          )}
        </li>
      ))}
    </ul>
  </section>
)}
