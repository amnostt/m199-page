---
import "../styles/globals.css";

interface Props {
  title?: string;
}

const { title = "Misión 1-99" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body data-theme="public">
    <slot />
  </body>
</html>
