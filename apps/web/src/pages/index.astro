---
/**
 * index.astro — server-rendered root page for the public landing
 * (PR3 root rendering).
 *
   * This page owns `GET /` and delegates presentation to `<Landing />`.
   * Sibling Astro pages own the remaining public routes; React is hydrated
   * only by the explicit admin page and focused interactive islands.
 *
 * The public layout imports the shared visual system. Calls the PR2 helper
 * `fetchLandingPublicPayload` against the server-only
 * `ASTRO_API_BASE_URL` validated in `apps/web/src/lib/server/env.ts`.
 * It also fetches a bounded newest-first publications list independently from
 * the landing payload and missions requests.
 *
 * On `LandingFetchError` (or any other thrown error) sets
 * `Astro.response.status = 503` and renders a non-sensitive failure
 * state. The failure copy is generic and never includes the failure
 * reason, the API host, the stack, or any driver detail. The
 * wrapper never echoes `cause.*` into the rendered output.
 */
import Landing from "../components/landing/Landing.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import {
  fetchLandingPublicPayload,
  LandingFetchError,
} from "../lib/server/landing.js";
import { resolveApiBaseUrl } from "../lib/server/env.js";
import { fetchMissionsList } from "../lib/server/missions.js";
import { fetchPublicationsList } from "../lib/server/publications.js";

const LANDING_PUBLICATION_LIMIT = 4;

let payload: import("../lib/server/landing.js").LandingPublicPayload | null =
  null;
let failure: { reason: string } | null = null;
let missions: import("../lib/server/missions.js").MissionListItem[] | null = null;
let publications:
  | import("../lib/server/publications.js").PublicationListItem[]
  | null = null;

try {
  const apiBaseUrl = resolveApiBaseUrl();
  payload = await fetchLandingPublicPayload({ apiBaseUrl });
} catch (cause) {
  // `LandingFetchError` is the only classified failure the helper
  // throws; anything else is collapsed to a single generic reason
  // so the failure markup never reflects internal classification.
  const reason = cause instanceof LandingFetchError ? cause.reason : "fetch_error";
  failure = { reason };
}

try {
  const apiBaseUrl = resolveApiBaseUrl();
  missions = (await fetchMissionsList(new URL("/", Astro.url), { apiBaseUrl })).items;
} catch (cause) {
  console.warn("Landing missions fetch failed", {
    reason: cause instanceof Error ? cause.name : "unknown",
  });
}

try {
  const apiBaseUrl = resolveApiBaseUrl();
  const requestUrl = new URL("/", Astro.url);
  requestUrl.searchParams.set("page", "1");
  requestUrl.searchParams.set("limit", String(LANDING_PUBLICATION_LIMIT));
  publications = (
    await fetchPublicationsList(requestUrl, { apiBaseUrl })
  ).items;
} catch (cause) {
  console.warn("Landing publications fetch failed", {
    reason: cause instanceof Error ? cause.name : "unknown",
  });
}

if (failure) {
  Astro.response.status = 503;
  Astro.response.statusText = "Service Unavailable";
}
---

<PublicLayout>
  <Landing
    payload={payload}
    failure={failure}
    missions={missions}
    publications={publications}
  />
</PublicLayout>
