---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PublicationCard from "../../components/publicaciones/PublicationCard.astro";
import PublicationPageNav from "../../components/publicaciones/PublicationPageNav.astro";
import PublicationsPagination from "../../components/publicaciones/PublicationsPagination.astro";
import PublicationsFilters from "../../components/publicaciones/PublicationsFilters.astro";
import { fetchPublicationsList, PublicationsFetchError } from "../../lib/server/publications.js";
import type { PublicationListItem } from "../../lib/server/publications.js";
const result = await fetchPublicationsList(Astro.url).catch((error) => error);
if (result instanceof PublicationsFetchError) Astro.response.status = 503;
const publications = result instanceof PublicationsFetchError ? null : result;
---
<PublicLayout title="Publicaciones | Misión 1-99">
  <main class="public-ui public-page public-publications-list" data-testid="publications-page">
    <PublicationPageNav current="list" />
    <header class="public-publications-list__header">
      <div class="public-publications-list__intro">
        <p class="public-publications-list__eyebrow">Archivo público</p>
        <h1>Publicaciones</h1>
        <p class="public-publications-list__description">
          Historias, salidas y momentos que mantienen viva la misión.
        </p>
      </div>
      <div class="public-publications-list__controls">
        {publications && (
          <p class="public-publications-list__count">
            {publications.total} {publications.total === 1 ? "publicación" : "publicaciones"}
          </p>
        )}
        <PublicationsFilters />
      </div>
    </header>
    {publications ? (
      <>
        <section class="public-publications-list__gallery" aria-label="Publicaciones">
          <div class="public-publications-list__grid">
            {publications.items.map((publication: PublicationListItem) => (
              <PublicationCard publication={publication} />
            ))}
          </div>
        </section>
        <PublicationsPagination
          {...publications}
          type={Astro.url.searchParams.get("type")}
        />
      </>
    ) : (
      <div class="public-state public-state--error" role="alert">
        <p>No pudimos cargar las publicaciones.</p>
      </div>
    )}
  </main>
</PublicLayout>
