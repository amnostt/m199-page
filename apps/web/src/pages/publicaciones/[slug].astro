---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PublicationBadges from "../../components/publicaciones/PublicationBadges.astro";
import PublicationContent from "../../components/publicaciones/PublicationContent.astro";
import PublicationMissionsList from "../../components/publicaciones/PublicationMissionsList.astro";
import { fetchPublicationBySlug, PublicationsFetchError } from "../../lib/server/publications.js";

let publication = null;
try {
  publication = await fetchPublicationBySlug(Astro.params.slug ?? "");
} catch (error) {
  Astro.response.status = error instanceof PublicationsFetchError && error.reason === "not_found" ? 404 : 503;
}
---
<PublicLayout title={publication ? `${publication.title} | Misión 1-99` : "Publicación | Misión 1-99"}>
  {publication ? <main class="public-ui public-publication-detail" data-testid="publication-detail">
    <p class="public-publication-card__type">{publication.type}</p>
    <h1>{publication.title}</h1>
    <p>{publication.excerpt}</p>
    <time datetime={publication.publishedAt}>{new Date(publication.publishedAt).toLocaleDateString("es-AR")}</time>
    {publication.featuredImageUrl && <img src={publication.featuredImageUrl} alt="" />}
    <PublicationBadges publication={publication} />
    <PublicationMissionsList missions={publication.missions} />
    <PublicationContent {...publication} />
  </main> : <div class="public-state public-state--error" role="alert"><p>No pudimos cargar esta publicación.</p></div>}
</PublicLayout>
