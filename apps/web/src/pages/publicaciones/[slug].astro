---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PublicationBadges from "../../components/publicaciones/PublicationBadges.astro";
import PublicationContent from "../../components/publicaciones/PublicationContent.astro";
import PublicationMissionsList from "../../components/publicaciones/PublicationMissionsList.astro";
import PublicationPageNav from "../../components/publicaciones/PublicationPageNav.astro";
import { fetchPublicationBySlug, PublicationsFetchError } from "../../lib/server/publications.js";

let publication = null;
try {
  publication = await fetchPublicationBySlug(Astro.params.slug ?? "");
} catch (error) {
  Astro.response.status = error instanceof PublicationsFetchError && error.reason === "not_found" ? 404 : 503;
}
---
<PublicLayout
  title={publication ? `${publication.title} | Misión 1-99` : "Publicación | Misión 1-99"}
>
  {publication ? (
    <main
      class:list={[
        "public-ui",
        "public-page",
        "public-publication-detail",
        {
          "public-publication-detail--without-media": !publication.featuredImageUrl,
        },
      ]}
      data-testid="publication-detail"
    >
      <PublicationPageNav current="detail" />
      <section class="public-publication-detail__hero" aria-labelledby="publication-title">
        <div class="public-publication-detail__hero-copy">
          <p class="public-publication-detail__type">{publication.type}</p>
          <h1 id="publication-title">{publication.title}</h1>
          <p class="public-publication-detail__excerpt">{publication.excerpt}</p>
          <div class="public-publication-detail__meta">
            <time datetime={publication.publishedAt}>
              {new Date(publication.publishedAt).toLocaleDateString("es-AR", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <PublicationBadges publication={publication} />
          </div>
          <a class="public-publication-detail__hero-link" href="#publication-content">
            Leer publicación
          </a>
        </div>
        {publication.featuredImageUrl && (
          <div class="public-publication-detail__hero-media">
            <img src={publication.featuredImageUrl} alt="" />
          </div>
        )}
      </section>
      <section
        class="public-publication-detail__content-section"
        id="publication-content"
        aria-labelledby="publication-content-title"
      >
        <div class="public-publication-detail__section-heading">
          <p>Contenido</p>
          <h2 id="publication-content-title">La historia continúa</h2>
        </div>
        <PublicationContent {...publication} />
      </section>
      <PublicationMissionsList missions={publication.missions} />
    </main>
  ) : (
    <div class="public-state public-state--error" role="alert">
      <p>No pudimos cargar esta publicación.</p>
    </div>
  )}
</PublicLayout>
